                {{ 'general.social.links.vimeo' | t }}
              </span>
            </a>
          </li>
        {%- endif -%}

      </ul>
    {% endif %}

    {% if section.settings.show_shopify_branding %}
      {% capture shopify %}
        <a
          class="shopify-link"
          href="//www.shopify.com"
          rel="nofollow"
          target="_blank"
          aria-describedby="a11y-new-window-message"
          aria-label="Shopify"
        >
          {{ 'icon-shopify.svg' | inline_asset_content }}
        </a>
      {% endcapture %}

      <small class="password__footer-caption password__footer-text">
        {{- 'general.password_page.powered_by_shopify_html' | t: shopify: shopify -}}
      </small>
    {% endif %}

    {% if section.settings.show_admin_login %}
      <small class="password__footer-login password__footer-text">
        {{ 'general.password_page.admin_link_html' | t }}
      </small>
    {% endif %}

  </div>

{% endif %}

<style>
  #PasswordFooter-{{ section.id }} {
    position: relative;
    z-index: 2;
  }

  #PasswordFooter-{{ section.id }} .list-social {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }

  #PasswordFooter-{{ section.id }} .list-social__link {
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  #PasswordFooter-{{ section.id }} .list-social__link:hover {
    opacity: 0.65;
    transform: translateY(-2px);
  }

  .password-footer-divider {
    margin: 0;
  }

  {% if section.settings.transparent_background %}

    /*
      Footer section ko normal document flow se remove karke
      previous section ke bottom par overlay karta hai.
    */
    #shopify-section-{{ section.id }} {
      position: absolute !important;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 30;
      width: 100%;
      margin: 0 !important;
      padding: 0 !important;
      pointer-events: none;
    }

    #PasswordFooter-{{ section.id }} {
      width: 100%;
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
      box-shadow: none !important;
      pointer-events: auto;
    }

    #shopify-section-{{ section.id }} .password-footer-divider {
      display: none !important;
    }

  {% else %}

    #shopify-section-{{ section.id }} {
      position: relative;
      width: 100%;
    }

  {% endif %}

  @media screen and (max-width: 749px) {
    {% if section.settings.transparent_background %}
      #PasswordFooter-{{ section.id }} {
        padding-left: 20px;
        padding-right: 20px;
      }
    {% endif %}
  }
</style>

{% schema %}
{
  "name": "Password footer",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_footer",
      "label": "Show complete footer",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show top divider line",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shopify_branding",
      "label": "Show Shopify branding",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_admin_login",
      "label": "Show admin login link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "Transparent background",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}