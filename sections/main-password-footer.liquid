{% assign scheme1 = settings.color_schemes | first %}

{% if section.settings.show_footer %}

  {%- if section.settings.show_divider and section.settings.color_scheme == scheme1 -%}
    <hr class="password-footer-divider">
  {%- endif -%}

  <div
    id="PasswordFooter-{{ section.id }}"
    class="
      password__footer
      color-{{ section.settings.color_scheme }}
      gradient
      {% if section.settings.transparent_background %}
        password__footer--transparent
      {% endif %}
    "
  >

    {% if section.settings.show_social_icons %}
      <ul class="list-social list-unstyled" role="list">

        {%- if settings.social_twitter_link != blank -%}
          <li class="list-social__item">
            <a
              href="{{ settings.social_twitter_link }}"
              class="link list-social__link"
              aria-label="{{ 'general.social.links.twitter' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-twitter.svg' | inline_asset_content -}}
              </span>

              <span class="visually-hidden">
                {{ 'general.social.links.twitter' | t }}
              </span>
            </a>
          </li>
        {%- endif -%}

        {%- if settings.social_facebook_link != blank -%}
