<section class="cs-teaser" style="--cs-teaser-pt: {{ section.settings.padding_top }}px; --cs-teaser-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width cs-teaser__grid">
    <div class="cs-teaser__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '500, 800, 1100, 1600',
            sizes: '(min-width: 750px) 50vw, 100vw',
            loading: 'lazy',
            class: 'cs-teaser__img'
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'cs-teaser__img' }}
      {%- endif -%}
    </div>
    <div class="cs-teaser__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="cs-teaser__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="cs-teaser__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="cs-teaser__text">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="cs-teaser__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cs-teaser {
    padding-top: calc(var(--cs-teaser-pt) * 0.75);
    padding-bottom: calc(var(--cs-teaser-pb) * 0.75);
  }
  .cs-teaser__grid {
    display: grid;
    gap: 3.2rem;
  }
  .cs-teaser__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #f3f3f3;
  }
  .cs-teaser__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1);
  }
  .cs-teaser__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .cs-teaser__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #555555;
  }
  .cs-teaser__heading {
    margin: 0;
    font-size: clamp(3.2rem, 5.2vw, 6.4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: #121212;
  }
  .cs-teaser__text {
    max-width: 46rem;
    margin-top: 2.4rem;
    font-size: 1.5rem;
    line-height: 1.7;
    color: #555555;
  }
  .cs-teaser__text p {
    margin: 0;
  }
  .cs-teaser__text p + p {
    margin-top: 1.2rem;
  }
  .cs-teaser__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.2rem;
    margin-top: 3.2rem;
    padding: 0 3.2rem;
    background: #121212;
    color: #ffffff;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.24s ease;
  }
  .cs-teaser__button:hover {
    opacity: 0.86;
  }
  .cs-teaser__button:focus-visible {
    outline: 0.2rem solid #121212;
    outline-offset: 0.3rem;
  }
  @media screen and (min-width: 750px) {
    .cs-teaser {
      padding-top: var(--cs-teaser-pt);
      padding-bottom: var(--cs-teaser-pb);
    }
    .cs-teaser__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: 6.4rem;
    }
    .cs-teaser__media {
      max-height: 86vh;
    }
  }
  @media screen and (min-width: 990px) {
    .cs-teaser__grid {
      gap: 9.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chosen story teaser",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Born from faith." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Chosen stands for the belief that every person is here for a reason.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 120 }
  ],
  "presets": [{ "name": "Chosen story teaser" }]
}
{% endschema %}
