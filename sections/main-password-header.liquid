{% if section.settings.show_complete_header %}
  <style>
    #PasswordHeader-{{ section.id }} {
      --password-logo-width: {{ settings.logo_width }}px;
      position: relative;
      z-index: 50;
      width: 100%;
    }

    #PasswordHeader-{{ section.id }} .password-logo {
      display: block;
      max-width: var(--password-logo-width);
      height: auto;
    }

    #PasswordHeader-{{ section.id }} .password-header {
      position: relative;
      z-index: 2;
      width: 100%;
    }

    #PasswordHeader-{{ section.id }}.password-header-wrapper--transparent,
    #PasswordHeader-{{ section.id }}.password-header-wrapper--transparent.gradient,
    #PasswordHeader-{{ section.id }}.password-header-wrapper--transparent .password-header {
      background: transparent !important;
      background-color: transparent !important;
      background-image: none !important;
      box-shadow: none !important;
    }

    {% if section.settings.transparent_background %}
      #shopify-section-{{ section.id }} {
        position: relative !important;
        z-index: 50 !important;
        width: 100% !important;
        margin: 0 !important;
        margin-bottom: calc(
          0px - var(--password-header-height, 0px)
        ) !important;
        background: transparent !important;
        pointer-events: none;
      }

      #PasswordHeader-{{ section.id }} {
        pointer-events: auto;
      }
    {% endif %}
  </style>

  <div
    id="PasswordHeader-{{ section.id }}"
    class="
      color-{{ section.settings.color_scheme }}
      gradient
      password-header-wrapper
      {% if section.settings.transparent_background %}
        password-header-wrapper--transparent
      {% endif %}
    "
  >
    <div class="password-header">
      {% if section.settings.show_logo %}
        {%- if settings.logo != blank -%}
          {%- assign logo_alt = settings.logo.alt
            | default: shop.name
            | escape
          -%}

          {%- assign logo_height = settings.logo_width
            | divided_by: settings.logo.aspect_ratio
          -%}

          {{
            settings.logo
            | image_url: width: 500
            | image_tag:
              class: 'password-logo',
              widths: '50, 100, 150, 200, 250, 300, 400, 500',
              width: settings.logo_width,
              height: logo_height,
              alt: logo_alt
          }}
        {%- elsif section.settings.show_shop_name -%}
          <h1 class="h2">{{ shop.name }}</h1>
        {%- endif -%}
      {% endif %}

      {% if section.settings.show_password_message %}
        {%- if shop.password_message != blank -%}
          <div class="password-content">
            {{ shop.password_message }}
          </div>
        {%- endif -%}
      {% endif %}

      {% if section.settings.show_password_login %}
        <password-modal>
          <details class="password-modal modal">
            <summary
              class="modal__toggle"
              aria-haspopup="dialog"
            >
              <div
                class="
                  modal__toggle-open
                  password-link
                  link
                  underlined-link
                "
              >
                {% if section.settings.show_lock_icon %}
                  <span class="svg-wrapper">
                    {{- 'icon-padlock.svg'
                      | inline_asset_content
                    -}}
                  </span>
                {% endif %}

                {% if section.settings.show_login_text %}
                  {{
                    'general.password_page.login_password_button'
                    | t
                  }}
                {% endif %}
              </div>

              <div
                class="modal__toggle-close"
                aria-hidden="true"
              >
                <span class="svg-wrapper">
                  {{- 'icon-close.svg'
                    | inline_asset_content
                  -}}
                </span>
              </div>
            </summary>

            <div
              class="modal__content"
              role="dialog"
              aria-labelledby="DialogHeading-{{ section.id }}"
              aria-modal="true"
            >
              <div
                class="password-modal__content"
                tabindex="-1"
              >
                <button
                  type="button"
                  class="modal__close-button link"
                  aria-label="{{ 'accessibility.close' | t }}"
                >
                  <span class="svg-wrapper">
                    {{- 'icon-close.svg'
                      | inline_asset_content
                    -}}
                  </span>
                </button>

                {% if section.settings.show_modal_heading %}
                  <h2
                    class="password-modal__content-heading"
                    id="DialogHeading-{{ section.id }}"
                  >
                    {{
                      'general.password_page.login_form_heading'
                      | t
                    }}
                  </h2>
                {% else %}
                  <span
                    id="DialogHeading-{{ section.id }}"
                    class="visually-hidden"
                  >
                    {{
                      'general.password_page.login_form_heading'
                      | t
                    }}
                  </span>
                {% endif %}

                {%- form
                  'storefront_password',
                  class: 'password-form'
                -%}
                  <div
                    class="
                      password-field
                      field
                      {% if form.errors %}
                        password-field--error
                      {% endif %}
                    "
                  >
                    <input
                      type="password"
                      name="password"
                      id="Password-{{ section.id }}"
                      class="field__input"
                      autocomplete="current-password"
                      {% if form.errors %}
                        aria-invalid="true"
                        aria-describedby="
                          PasswordLoginForm-password-error-{{ section.id }}
                        "
                      {% endif %}
                      placeholder="{{
                        'general.password_page.login_form_password_placeholder'
                        | t
                      }}"
                    >

                    <label
                      class="field__label"
                      for="Password-{{ section.id }}"
                    >
                      {{
                        'general.password_page.login_form_password_placeholder'
                        | t
                      }}
                    </label>

                    {%- if form.errors -%}
                      <div
                        id="
                          PasswordLoginForm-password-error-{{ section.id }}
                        "
                        role="status"
                      >
                        <span class="visually-hidden">
                          {{ 'accessibility.error' | t }}
                        </span>

                        <span class="form__message">
                          <span class="svg-wrapper">
                            {{- 'icon-error.svg'
                              | inline_asset_content
                            -}}
                          </span>

                          {{
                            'general.password_page.login_form_error'
                            | t
                          }}
                        </span>
                      </div>
                    {%- endif -%}
                  </div>

                  <button
                    name="commit"
                    class="
                      password-button
                      button
                      button--outline
                    "
                  >
                    {{
                      'general.password_page.login_form_submit'
                      | t
                    }}
                  </button>
                {%- endform -%}

                {% if section.settings.show_admin_link %}
                  <small class="
                    password__footer-text
                    password-modal__admin-link
                  ">
                    {{
                      'general.password_page.admin_link_html'
                      | t
                    }}
                  </small>
                {% endif %}
              </div>
            </div>
          </details>
        </password-modal>
      {% endif %}
    </div>
  </div>

  {% assign scheme1 = settings.color_schemes | first %}

  {% if section.settings.show_divider %}
    {%- if section.settings.transparent_background == false -%}
      {%- if section.settings.color_scheme == scheme1 -%}
        <hr class="password-header-divider">
      {%- endif -%}
    {%- endif -%}
  {% endif %}

  {% if section.settings.transparent_background %}
    <script>
      (function () {
        const sectionWrapper = document.getElementById(
          'shopify-section-{{ section.id }}'
        );

        const header = document.getElementById(
          'PasswordHeader-{{ section.id }}'
        );

        if (!sectionWrapper || !header) return;

        function setPasswordHeaderHeight() {
          const headerHeight = header.getBoundingClientRect().height;

          sectionWrapper.style.setProperty(
            '--password-header-height',
            headerHeight + 'px'
          );
        }

        setPasswordHeaderHeight();

        window.addEventListener(
          'load',
          setPasswordHeaderHeight
        );

        window.addEventListener(
          'resize',
          setPasswordHeaderHeight
        );

        if ('ResizeObserver' in window) {
          const headerObserver = new ResizeObserver(function () {
            setPasswordHeaderHeight();
          });

          headerObserver.observe(header);
        }

        document.addEventListener(
          'shopify:section:load',
          function (event) {
            if (
              event.target &&
              event.target.id ===
                'shopify-section-{{ section.id }}'
            ) {
              setPasswordHeaderHeight();
            }
          }
        );
      })();
    </script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Password header",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_complete_header",
      "label": "Show complete header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_shop_name",
      "label": "Show shop name when logo is empty",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_password_message",
      "label": "Show password message",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_password_login",
      "label": "Show password login",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_lock_icon",
      "label": "Show lock icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_login_text",
      "label": "Show login text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_modal_heading",
      "label": "Show popup heading",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_admin_link",
      "label": "Show admin login link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show bottom divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "checkbox",
      "id": "transparent_background",
      "label": "Transparent and overlay next section",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "paragraph",
      "content": "Logo image and width are controlled from Theme settings."
    }
  ]
}
{% endschema %}