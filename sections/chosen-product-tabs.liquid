{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-swatch.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign columns = section.settings.columns_desktop
  assign per_tab = section.settings.products_to_show
  assign visible_block_count = 0
-%}
{%- for block in section.blocks -%}
  {%- liquid
    assign tab_collection = collections[block.settings.collection]
    assign tab_has_products = false
    for tab_product in tab_collection.products
      if section.settings.hide_current_product and tab_product.id == product.id
        continue
      endif
      assign tab_has_products = true
      break
    endfor
    if tab_has_products
      assign visible_block_count = visible_block_count | plus: 1
    endif
  -%}
{%- endfor -%}

{%- comment -%}
  Only render the section once at least one tab's collection actually has
  products to show. Empty tabs (e.g. T-Shirts before that drop launches) are
  skipped entirely rather than shown with an empty state, so the section
  appears on its own once real products land in that collection.
{%- endcomment -%}
{%- if visible_block_count > 0 -%}
  <section
    id="ChosenTabs-{{ section.id }}"
    class="chosen-tabs{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    {% comment %}
      No inline style here on purpose. animations.js does
      setAttribute('style', '--animation-order: N') on any data-cascade
      element, wiping whatever was already there. The column count lives on
      the grid below instead, where nothing overwrites it.
    {% endcomment %}
    {% if settings.animations_reveal_on_scroll %}data-cascade{% endif %}
  >
    <div class="chosen-tabs__head page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="chosen-tabs__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="chosen-tabs__nav" role="tablist">
        {%- assign visible_index = -1 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign tab_collection = collections[block.settings.collection]
            assign tab_has_products = false
            for tab_product in tab_collection.products
              if section.settings.hide_current_product and tab_product.id == product.id
                continue
              endif
              assign tab_has_products = true
              break
            endfor
          -%}
          {%- if tab_has_products -%}
            {%- assign visible_index = visible_index | plus: 1 -%}
            {%- liquid
              assign tab_label = block.settings.label
              if tab_label == blank
                assign tab_label = tab_collection.title
              endif
            -%}
            <button
              type="button"
              class="chosen-tabs__tab"
              role="tab"
              id="ChosenTab-{{ section.id }}-{{ visible_index }}"
              aria-controls="ChosenPanel-{{ section.id }}-{{ visible_index }}"
              aria-selected="{% if visible_index == 0 %}true{% else %}false{% endif %}"
              data-index="{{ visible_index }}"
              {{ block.shopify_attributes }}
            >
              {{ tab_label | escape }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="chosen-tabs__panels">
      {%- assign visible_index = -1 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign tab_collection = collections[block.settings.collection]
          assign tab_has_products = false
          for tab_product in tab_collection.products
            if section.settings.hide_current_product and tab_product.id == product.id
              continue
            endif
            assign tab_has_products = true
            break
          endfor
        -%}
        {%- if tab_has_products -%}
          {%- assign visible_index = visible_index | plus: 1 -%}
          {%- assign shown = 0 -%}
          <div
            class="chosen-tabs__panel"
            role="tabpanel"
            id="ChosenPanel-{{ section.id }}-{{ visible_index }}"
            aria-labelledby="ChosenTab-{{ section.id }}-{{ visible_index }}"
            data-index="{{ visible_index }}"
            {% unless visible_index == 0 %}
              hidden
            {% endunless %}
          >
            <ul
              class="chosen-tabs__grid list-unstyled"
              role="list"
              style="--chosen-tabs-columns: {{ columns }};"
            >
              {%- for tab_product in tab_collection.products -%}
                {%- if section.settings.hide_current_product and tab_product.id == product.id -%}
                  {%- continue -%}
                {%- endif -%}
                {%- if shown >= per_tab -%}
                  {%- break -%}
                {%- endif -%}
                {%- assign shown = shown | plus: 1 -%}
                <li class="chosen-tabs__item">
                  {% render 'card-product',
                    card_product: tab_product,
                    media_aspect_ratio: section.settings.image_ratio,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: false,
                    show_rating: false,
                    section_id: section.id
                  %}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <script>
    (function () {
      var root = document.getElementById('ChosenTabs-{{ section.id }}');
      if (!root) return;

      var tabs = Array.prototype.slice.call(root.querySelectorAll('.chosen-tabs__tab'));
      var panels = Array.prototype.slice.call(root.querySelectorAll('.chosen-tabs__panel'));

      function select(index) {
        tabs.forEach(function (tab) {
          tab.setAttribute('aria-selected', String(Number(tab.dataset.index) === index));
        });
        panels.forEach(function (panel) {
          if (Number(panel.dataset.index) === index) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });
      }

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          select(Number(tab.dataset.index));
        });

        // Left/right arrows move between tabs, matching normal tablist behaviour.
        tab.addEventListener('keydown', function (event) {
          if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
          event.preventDefault();
          var step = event.key === 'ArrowRight' ? 1 : -1;
          var next = (Number(tab.dataset.index) + step + tabs.length) % tabs.length;
          select(next);
          tabs[next].focus();
        });
      });
    })();
  </script>
{%- endif -%}

<style>
  /*
    Scoped by id so these beat component-card.css, which Dawn loads from inside
    whichever section renders a card.
  */
  #ChosenTabs-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #ChosenTabs-{{ section.id }} .chosen-tabs__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
    padding-bottom: 2.4rem;
    text-align: center;
  }

  #ChosenTabs-{{ section.id }} .chosen-tabs__heading {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #ChosenTabs-{{ section.id }} .chosen-tabs__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.4rem;
  }

  #ChosenTabs-{{ section.id }} .chosen-tabs__tab {
    padding: 0 0 0.6rem;
    border: 0;
    border-bottom: 0.2rem solid transparent;
    background: none;
    color: rgba(var(--color-foreground), 0.55);
    font-family: inherit;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  #ChosenTabs-{{ section.id }} .chosen-tabs__tab:hover {
    color: rgba(var(--color-foreground), 0.85);
  }

  #ChosenTabs-{{ section.id }} .chosen-tabs__tab[aria-selected='true'] {
    color: rgb(var(--color-foreground));
    border-bottom-color: rgb(var(--color-foreground));
  }

  #ChosenTabs-{{ section.id }} .chosen-tabs__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    background-color: transparent;
  }

  /* Hairlines on the cells rather than a grey sheet behind gaps, so a part
     filled last row stays white instead of showing grey blocks. */
  #ChosenTabs-{{ section.id }} .chosen-tabs__item {
    margin: 0;
    box-shadow: inset -0.1rem 0 0 0 rgba(var(--color-foreground), 0.08),
      inset 0 -0.1rem 0 0 rgba(var(--color-foreground), 0.08);
  }

  #ChosenTabs-{{ section.id }} .card-wrapper,
  #ChosenTabs-{{ section.id }} .card,
  #ChosenTabs-{{ section.id }} .card__inner {
    border-radius: 0;
    box-shadow: none;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content {
    padding: 1.4rem 1.2rem 1.6rem;
    background-color: rgb(var(--color-background));
    min-height: 9.6rem;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card__information {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: start;
    column-gap: 1.6rem;
    row-gap: 0.4rem;
    padding: 0;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card__heading {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.35;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card-information {
    grid-column: 2;
    grid-row: 1;
    text-align: right;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card-information > *,
  #ChosenTabs-{{ section.id }} .card > .card__content .card-information .price {
    margin-top: 0;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card-information .price {
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.35;
    white-space: nowrap;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card__variant {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card__variant-name {
    display: block;
    margin-bottom: 1rem;
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.62);
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card__swatches {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card__swatches .swatch {
    display: block;
    width: 1.4rem;
    height: 1.4rem;
    border-radius: 50%;
    background: var(--swatch--background, transparent);
    background-size: cover;
    background-position: center;
    box-shadow: inset 0 0 0 0.1rem rgba(var(--color-foreground), 0.22);
  }

  #ChosenTabs-{{ section.id }} .card > .card__content .card__swatch-count {
    margin-left: 0.4rem;
    font-size: 1.2rem;
    color: rgba(var(--color-foreground), 0.62);
  }

  @media screen and (min-width: 990px) {
    #ChosenTabs-{{ section.id }} .chosen-tabs__grid {
      grid-template-columns: repeat(var(--chosen-tabs-columns), 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Chosen product tabs",
  "tag": "section",
  "class": "chosen-tabs-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products per tab",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_current_product",
      "label": "Hide the product being viewed",
      "default": true
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "info": "Leave blank to use the collection title." },
        { "type": "collection", "id": "collection", "label": "Collection" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chosen product tabs",
      "blocks": [{ "type": "tab" }, { "type": "tab" }, { "type": "tab" }]
    }
  ]
}
{% endschema %}
