<section class="cs-duo" style="--cs-duo-pt: {{ section.settings.padding_top }}px; --cs-duo-pb: {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="cs-duo__head">
        {%- if section.settings.eyebrow != blank -%}
          <p class="cs-duo__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="cs-duo__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cs-duo__grid">
      {%- for block in section.blocks -%}
        <a
          class="cs-duo__card"
          href="{{ block.settings.link | default: '#' }}"
          {{ block.shopify_attributes }}
        >
          <div class="cs-duo__media">
            {%- if block.settings.image != blank -%}
              {%- assign focus = block.settings.focus_x | default: 50 -%}
              {%- capture focus_style -%}object-position: {{ focus }}% 78%;{%- endcapture -%}
              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  widths: '400, 600, 800, 1100, 1400',
                  sizes: '50vw',
                  loading: 'lazy',
                  class: 'cs-duo__img',
                  style: focus_style
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'cs-duo__img cs-duo__img--placeholder' }}
            {%- endif -%}
          </div>
          <div class="cs-duo__info">
            <div>
              {%- if block.settings.title != blank -%}
                <p class="cs-duo__title">{{ block.settings.title | escape }}</p>
              {%- endif -%}
              {%- if block.settings.subtitle != blank -%}
                <p class="cs-duo__subtitle">{{ block.settings.subtitle | escape }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.cta != blank -%}
              <span class="cs-duo__cta">{{ block.settings.cta | escape }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .cs-duo {
    padding-top: calc(var(--cs-duo-pt) * 0.75);
    padding-bottom: calc(var(--cs-duo-pb) * 0.75);
  }
  .cs-duo__head {
    margin-bottom: 2.4rem;
  }
  .cs-duo__eyebrow {
    margin: 0 0 0.8rem;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #555555;
  }
  .cs-duo__heading {
    margin: 0;
    font-size: clamp(2.8rem, 4.4vw, 5.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: #121212;
  }
  .cs-duo__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }
  .cs-duo__card {
    display: block;
    color: #121212;
    text-decoration: none;
  }
  .cs-duo__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #f3f3f3;
  }
  .cs-duo__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 78%;
    filter: grayscale(1);
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cs-duo__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
    padding: 1.4rem 0 0;
  }
  .cs-duo__title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .cs-duo__subtitle {
    margin: 0.4rem 0 0;
    font-size: 1.3rem;
    color: #555555;
  }
  .cs-duo__cta {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-bottom: 0.1rem solid currentColor;
    padding-bottom: 0.2rem;
  }
  .cs-duo__card:focus-visible {
    outline: 0.2rem solid #121212;
    outline-offset: 0.3rem;
  }
  @media (hover: hover) {
    .cs-duo__card:hover .cs-duo__img {
      transform: scale(1.03);
    }
  }
  @media screen and (min-width: 750px) {
    .cs-duo {
      padding-top: var(--cs-duo-pt);
      padding-bottom: var(--cs-duo-pb);
    }
    .cs-duo__head {
      margin-bottom: 4rem;
    }
    .cs-duo__grid {
      gap: 0.6rem;
    }
    .cs-duo__media {
      aspect-ratio: 1;
    }
    .cs-duo__info {
      gap: 1.4rem;
      padding-top: 1.8rem;
    }
    .cs-duo__title {
      font-size: 1.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs-duo__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Chosen colour duo",
  "tag": "div",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two colours." },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 8, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Solid Black" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "CHF 79" },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Shop" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "range", "id": "focus_x", "min": 0, "max": 100, "step": 5, "unit": "%", "label": "Horizontal image focus", "default": 50 }
      ]
    }
  ],
  "presets": [
    {
      "name": "Chosen colour duo",
      "blocks": [{ "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
